# Vzor premenných pre `docker compose` (deploy/compose.yaml).
# Skopíruj ako deploy/.env a doplň reálne hodnoty; compose číta aj koreňový .env.
# Súbor .env je v .gitignore — reálne kľúče nikdy necommituj.

# Doména pre Caddy auto-SSL (VPS), mr. `app.lov-devil.sk` — bez www
SITE_ADDRESS=app.lov-devil.sk

# --- GitHub OAuth (dopĺňa koreňový .env, len prepise pre produkciu) ---
# GITHUB_CALLBACK_URL=https://app.lov-devil.sk/api/github/auth/callback
# LOV_APP_URL=https://app.lov-devil.sk/
# GITHUB_ALLOWED_ORIGINS=https://app.lov-devil.sk
