      ]
    },
    {
      "finding": "discussion_r4496756209",
      "area": "src/features/publish/PublishDialog.tsx",
      "implementation": "Only allowlisted definitive POST input rejections release the captured matching receipt. Explicit retry after reconciliation saves the current revision and creates a new UUID. Network/timeout/protocol/server uncertainty and publish_request_conflict preserve the original request. Account/project epochs and compare-and-remove prevent late cleanup of another or newer receipt.",
      "verification": [
        "unchanged local source plus reconciled revision retries with a fresh saved revision/UUID",
        "uncertain results and owner/project changes preserve recovery identity"
      ]
    },
    {
      "finding": "discussion_r4496756182",
      "area": "modern ForgePublish.tsx",
      "implementation": "A verified terminal failed job clears only its matching stored request after owner/version/result checks; first explicit retry after reopening starts a fresh UUID. Building and uncertain attempts remain recoverable.",
      "verification": [
        "failed → close/reopen → first retry regression",
        "wrong revision and newer stored receipt preserved"
      ]
    },
