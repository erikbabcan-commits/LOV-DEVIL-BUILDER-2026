# Include INSIDE the existing API HTTPS server block AFTER deploying the signed handler.
# Replace __LOV_API_PORT__ with the loopback port of the existing /api/ proxy_pass.
# Keep the existing auth_basic protection on all other API/editor routes.
location = /api/billing/webhook {
    auth_basic off;
    # Exact location matching uses a normalized URI. Require the original target too.
    if ($request_uri != /api/billing/webhook) { return 404; }
    if ($request_method != POST) { return 405; }
    client_max_body_size 512k;
    proxy_pass http://127.0.0.1:__LOV_API_PORT__;
    proxy_pass_request_headers off;
    proxy_set_header Host $host;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Stripe-Signature $http_stripe_signature;
    proxy_hide_header Set-Cookie;
}
