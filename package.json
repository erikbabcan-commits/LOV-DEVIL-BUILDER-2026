{
  "name": "lov-devil-builder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "server": "cross-env LOV_SERVER=1 tsx server/index.ts",
    "server:dev": "cross-env LOV_SERVER=1 SANDBOX_MODE=host tsx watch server/index.ts",
    "server:mock": "cross-env LOV_SERVER=1 SANDBOX_MODE=host MOCK_AI=1 PORT=8787 tsx server/index.ts",
    "server:e2e": "cross-env LOV_SERVER=1 SANDBOX_MODE=host MOCK_AI=1 PORT=8788 GITHUB_CLIENT_ID=e2e-client GITHUB_CLIENT_SECRET=e2e-secret GITHUB_OAUTH_SCOPE=public_repo GITHUB_CALLBACK_URL=http://127.0.0.1:8788/api/github/auth/callback GITHUB_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:8788 LOV_APP_URL=http://localhost:5174/ tsx server/index.ts",
    "dev:e2e": "cross-env VITE_API_PROXY_TARGET=http://127.0.0.1:8788 vite --port 5174 --strictPort",
    "db:migrate": "tsx server/db/migrate.ts",
    "github:preflight": "tsx scripts/check-cloud-github.ts",
    "ai:usage-report": "tsx scripts/ai-usage-report.ts",
    "templates:verify": "tsx scripts/verify-blueprints.ts",
    "ai:intent-eval": "tsx scripts/eval-intent.ts",
    "zip:verify": "tsx scripts/verify-project-zip.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lint": "6.9.7",
    "@uiw/react-codemirror": "4.25.12",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "file-saver": "^2.0.5",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "23.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hono/node-server": "^2.1.4",
    "@playwright/test": "^1.56.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.4"
  }
}
