{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lov.2.29.52.59.sslip.io/api/:path*"
    },
    {
      "source": "/p/:path*",
      "destination": "https://lov.2.29.52.59.sslip.io/p/:path*"
    },
    {
      "source": "/((?!api|p).*)$",
      "destination": "/index.html"
    }
  ]
}
