# M2 AI engine — server environment (NIKDY necommituj reálny kľúč!)
# Mistral API kľúč — len pre serverový proces
MISTRAL_API_KEY=your-mistral-api-key-here

# Model (voliteľné)
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Server
PORT=8787

# GitHub OAuth App (copy this file to repository-root .env; never commit real values)
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:8787/api/github/auth/callback
LOV_APP_URL=http://localhost:5173/

# Classic OAuth limitation: `repo` is broad access to public and private repositories.
# Default `public_repo` limits export to public repositories.
# `repo` requires a separate explicit decision and broader OAuth consent.
GITHUB_OAUTH_SCOPE=public_repo

# Allowlist origin pre CORS/CSRF guard servera (server/index.ts + oauthPolicy.ts)
GITHUB_ALLOWED_ORIGINS=http://localhost:5173
# Šifrované OAuth session súbory (server/security/sessionStore.ts)
GITHUB_SESSION_SECRET=
GITHUB_SESSION_DIR=.sessions

# Bind interface servera — 0.0.0.0 len v Dockeri / za reverse proxy (deploy/)
# BIND=127.0.0.1
# AI generácia on/off (default on)
# AI_GENERATION_ENABLED=1

# WS-1: User auth + trvalé kvóty (default VYPNUTÉ — pilot mód bez zmien)
# AUTH_ENABLED=1 vyžaduje: DATABASE_URL, JWT_SECRET (min 32 znakov)
# AUTH_ENABLED=1
# DATABASE_URL=postgresql://user:pass@localhost:5432/forge
# JWT_SECRET=openssl rand -hex 32
# REDIS_URL=redis://localhost:6379
# Migrácie: npm run db:migrate (alebo sa aplikujú automaticky pri štarte s AUTH_ENABLED=1)

# Voliteľný hybrid Lovable Cloud → Hono (default vypnuté).
# Presný issuer over z reálneho Cloud projektu; HS256 nepodporujeme.
# CLOUD_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Vyžaduje AUTH_ENABLED=1 a explicitný identity_links záznam pre existujúceho usera.
# Nikdy nepreberaj issuer z prijatého JWT ani nespájaj účty podľa emailu.

# Samostatný Cloud GitHub BFF flow. Samotná prítomnosť Secrets nič nezapne.
GITHUB_CLOUD_ENABLED=0
GITHUB_CLOUD_EXPORT_ENABLED=0
# Vyžaduje AUTH_ENABLED=1, DATABASE_URL, JWT_SECRET, CLOUD_AUTH_ISSUER a migrácie 001–007.
# GITHUB_CLOUD_CLIENT_ID=
# GITHUB_CLOUD_CLIENT_SECRET=
# GITHUB_CLOUD_ALLOWED_ORIGIN=https://<jedna-frontend-domena>
# GITHUB_CLOUD_CALLBACK_URL=https://<jedna-frontend-domena>/github/callback
# GITHUB_CLOUD_ENCRYPTION_KEY= (nezávislých 32 random bajtov ako 64 hex znakov)
# GITHUB_BRIDGE_SECRET= (iných 32 random bajtov ako 64 hex znakov; rovnaký iba v BFF)
# Kľúče nerecykluj z JWT_SECRET, GITHUB_SESSION_SECRET ani SANDBOX_RUNNER_TOKEN.
# Scope je pevný public_repo. Legacy GITHUB_* konfigurácia/callback sa nemení.
# npm run github:preflight -- --env-file <private-env> [--check-db]
# Preflight nič nemigruje/neprepája; žiadne GitHub ani platené AI volania.

# Prevádzková kapacita na účet (vrátane koša), nezávislá od billing plánov.
# Default: 64 MiB JSONB workspace dokumentov a 100 uložených projektov.
# PROJECT_STORAGE_MAX_BYTES=67108864
# PROJECT_STORAGE_MAX_PROJECTS=100
# Zníženie limitu nemaže dáta; povolené ostáva čítanie, obnova a nezväčšujúce uloženie.

# WS-4: default isolated, bez runnera build zlyhá bezpečne (žiadny fallback).
SANDBOX_MODE=isolated
# Súkromný runner; tieto premenné nepatria do VITE_* ani do worker image.
SANDBOX_RUNNER_URL=http://127.0.0.1:8790/
# Generuj nezávislý random token (min 32 znakov); nikdy nepouži JWT/OAuth secrets.
SANDBOX_RUNNER_TOKEN=
# Len vedomý lokálny vývoj bez hard limitov: SANDBOX_MODE=host
# npm run server:dev / server:mock / server:e2e zvolia host explicitne.

# Optional operator-verified AI cost estimates (USD per million uncached text tokens).
# Default absent = no price policy; unknown costs stay unknown, never zero.
# AI_PRICE_POLICY_JSON= (one-line JSON, schema/example in deploy/ops/ai-price-policy.example.json)
# The example uses fictional prices/provider/model; replace and verify every field.
# Prices are server-only. Do not use VITE_*; changing policy never reprices old calls.
# Report: pnpm run ai:usage-report -- --month YYYY-MM [--user-id <internal-id>] [--plan free|pro] --env-file <private-0600-env>
# Report requires DATABASE_URL (SELECT-only role sufficient), no AI or billing credentials.

# WS-9: výber AI providera (iba server, nikdy VITE_*).
# Mistral zachováva existujúci režim: kľúč zapne provider; 0 ho výslovne vypne.
# AI_MISTRAL_ENABLED=0
# Nové providery sú default OFF aj pri existujúcom globálnom API kľúči.
# Zapnutie vyžaduje 1, vlastný serverový kľúč a explicitný platný model ID.
# AI_OPENAI_ENABLED=0
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_ANTHROPIC_ENABLED=0
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AI_DEFAULT_MODEL=mistral (ID povoleného providera: mistral|openai|anthropic)
# AI_FALLBACK_MODELS= (default žiadny; najviac 2 povolené ID, oddelené čiarkou)
# Fallback vyžaduje aj čerstvý opt-in používateľa s presnými príjemcami.
# PROVIDER_TIMEOUT_MS=120000 (100–120000; samotný request má tiež deadline)
# *_BASE_URL sú voliteľné dôveryhodné serverové HTTPS endpointy; žiadny redirect.
# Každý fyzický pokus sa účtuje do tokenov/cost ledgeru; mesačná úloha iba raz.
# Detaily, retry limity a hranice overenia: docs/WS-9-PROVIDERS.md.

# WS-10: celkové kontextové okno overené operátorom pre konkrétny model.
# Default 65536 je aplikačný strop, NIE objavená schopnosť modelu.
# Nastav podľa dokumentácie svojho modelu, 8192–2000000; všetci fallback príjemcovia
# musia zvládnuť použitý kontext. Použije sa najmenšie okno v povolenom reťazci.
# MISTRAL_CONTEXT_WINDOW_TOKENS=65536
# OPENAI_CONTEXT_WINDOW_TOKENS=65536
# ANTHROPIC_CONTEXT_WINDOW_TOKENS=65536
# Starších než 8 správ = merané AI zhrnutie, potom plán/generovanie.
# Súbory sa neskracujú; nadmerný snapshot HTTP 413 pred mesačnou kvótou.
BILLING_ENABLED=0
# Sandbox-only billing foundation. Separate keys from CLI/MCP OAuth; never use VITE_ names.
# Requires AUTH_ENABLED=1 and migration 010. No credentials are created by setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_APP_URL=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
# Integer EUR cents; server checks exact amount/currency/interval against Stripe.
BILLING_PRO_MONTHLY_EUR_CENTS=
BILLING_PRO_YEARLY_EUR_CENTS=
