# M2 AI engine — server environment (NIKDY necommituj reálny kľúč!)
# Mistral API kľúč — len pre serverový proces
MISTRAL_API_KEY=your-mistral-api-key-here

# Model (voliteľné)
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Server
PORT=8787

# GitHub OAuth App (copy this file to repository-root .env; never commit real values)
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:8787/api/github/auth/callback
LOV_APP_URL=http://localhost:5173/

# Classic OAuth limitation: `repo` is broad access to public and private repositories.
# Use `public_repo` when private repository export is not required.
GITHUB_OAUTH_SCOPE=repo

# Allowlist origin pre CORS/CSRF guard servera (server/index.ts + oauthPolicy.ts)
GITHUB_ALLOWED_ORIGINS=http://localhost:5173
# Šifrované OAuth session súbory (server/security/sessionStore.ts)
GITHUB_SESSION_SECRET=
GITHUB_SESSION_DIR=.sessions

# Bind interface servera — 0.0.0.0 len v Dockeri / za reverse proxy (deploy/)
# BIND=127.0.0.1
# AI generácia on/off (default on)
# AI_GENERATION_ENABLED=1

# WS-1: User auth + trvalé kvóty (default VYPNUTÉ — pilot mód bez zmien)
# AUTH_ENABLED=1 vyžaduje: DATABASE_URL, JWT_SECRET (min 32 znakov)
# AUTH_ENABLED=1
# DATABASE_URL=postgresql://user:pass@localhost:5432/forge
# JWT_SECRET=openssl rand -hex 32
# REDIS_URL=redis://localhost:6379
# Migrácie: npm run db:migrate (alebo sa aplikujú automaticky pri štarte s AUTH_ENABLED=1)
